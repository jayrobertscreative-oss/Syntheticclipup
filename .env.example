# Copy to .env and fill in. Never commit .env or put these keys in frontend code.

# Speech-to-text (OpenAI audio API, word timestamps)
OPENAI_API_KEY=
# Highlight analysis (Claude API)
ANTHROPIC_API_KEY=
SCU_CLAUDE_MODEL=claude-sonnet-5-5
# Optional: YouTube Data API v3 key for link details (title, thumbnail, duration)
YOUTUBE_API_KEY=

# Long random string. Signs private media links. Generate with:  python -c "import secrets;print(secrets.token_hex(32))"
SCU_SECRET=
# Optional until Phase 2 accounts: anyone opening the site must enter this key.
SCU_ACCESS_KEY=

# Where uploads, clips and the database live (use a persistent disk in production)
SCU_DATA_DIR=./data
SCU_MAX_UPLOAD_MB=2048
SCU_MAX_DURATION_MIN=180
